# ============================================================================
# Smart Fridge — Environment Configuration Example
# Copy values into your shell environment or local .env files as needed.
# All tools and dependencies are 100% free and open-source.
# ============================================================================

# --- Backend Configuration ---
# Use 'dev' for file-backed H2 fallback (no PostgreSQL install required)
# Use 'postgres' when running against a real PostgreSQL instance
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# --- PostgreSQL Configuration (used when SPRING_PROFILES_ACTIVE=postgres) ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/smart_fridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8081
